{
  "schemaVersion": 1,
  "id": "drotiesel.fw12-tablet",
  "name": "Framework 12 tablet",
  "version": "0.1.0",
  "author": "Sven Mathieu",
  "description": "On-screen keyboard and tablet-mode indicator for the Framework Laptop 12.",
  "kinds": [
    "service",
    "panel",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "panel": "Keyboard.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Tablet",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
